# Copy this file to .env.local and replace the placeholder values.
# Do not add .env.local or any secret/server key to Git.

# --- Core (required for dev) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# --- Phase 7: n8n automation (server-only) ---
# Service role key is read ONLY in lib/automation/auth.ts (createServiceSupabase).
# Never expose it to the browser. n8n workflows read it server-side via env.
SUPABASE_SERVICE_ROLE_KEY=
N8N_WEBHOOK_SECRET=
# 32-byte key; generate with: openssl rand -hex 24
N8N_ENCRYPTION_KEY=

# --- Phase 8: optional vision (diagram understanding + image Q&A) ---
# Ingest-time diagram descriptions and query-time image Q&A. Omit/leave blank
# to disable vision entirely (image OCR via tesseract remains free/local).
AI_VISION_MODEL=
AI_VISION_BASE_URL=
AI_VISION_API_KEY=
VISION_DIAGRAMS_ENABLED=
# NOTE: MAX_VISION_IMAGES_PER_RESOURCE is a code constant (lib/documents/types.ts,
# value 10), not an env var. Do not set it here.

# --- Phase 9: embeddings (optional) ---
# Leave AI_EMBEDDING_MODEL empty to use keyword search only (no embeddings).
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSIONS=768
# Optional; falls back to AI_BASE_URL if unset.
AI_EMBEDDING_BASE_URL=
# Optional; falls back to AI_API_KEY if unset.
AI_EMBEDDING_API_KEY=
MAX_EMBEDDABLE_CHUNKS_PER_RESOURCE=200

# --- AI provider fallback (free-tier, for redundancy/speed) ---
# Primary provider is OpenRouter (via AI_* variables above). Set GROQ as fallback.
# Groq free tier: https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Alternative fallback: Google Gemini (free tier available)
# GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
