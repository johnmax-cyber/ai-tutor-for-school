{
  "name": "study-reminder",
  "nodes": [
    {
      "parameters": {
        "triggerTimes": { "interval": [ { "cron": "0 * * * *" } ] }
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000001",
      "name": "Every hour",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1.2,
      "position": [280, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.NEXT_PUBLIC_SUPABASE_URL}}/rest/v1/user_preferences?select=user_id,reminder_time&study_reminders_enabled=eq.true",
        "authentication": "none",
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}" },
            { "name": "Authorization", "value": "=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}" }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Supabase: reminder-enabled users",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [520, 300]
    },
    {
      "parameters": { "batchSize": 10 },
      "id": "a1b2c3d4-0002-4000-8000-000000000003",
      "name": "Split in batches (users)",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 1,
      "position": [760, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ ($json.reminder_time || '').substring(0, 2) }}",
              "operation": "equal",
              "value2": "={{ $now.format('HH') }}"
            }
          ]
        }
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000004",
      "name": "IF reminder hour matches now",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.4,
      "position": [1000, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.APP_URL}}/api/webhooks/n8n/reminder-notification",
        "authentication": "none",
        "headerParameters": {
          "parameters": [
            { "name": "x-n8n-webhook-secret", "value": "={{$env.N8N_WEBHOOK_SECRET}}" }
          ]
        },
        "body": {
          "userId": "={{$json.user_id}}"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000005",
      "name": "Call reminder-notification webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1240, 200]
    }
  ],
  "connections": {
    "Every hour": { "main": [ [ { "node": "Supabase: reminder-enabled users", "type": "main", "index": 0 } ] ] },
    "Supabase: reminder-enabled users": { "main": [ [ { "node": "Split in batches (users)", "type": "main", "index": 0 } ] ] },
    "Split in batches (users)": { "main": [ [ { "node": "IF reminder hour matches now", "type": "main", "index": 0 } ] ] },
    "IF reminder hour matches now": { "main": [ [ { "node": "Call reminder-notification webhook", "type": "main", "index": 0 } ] ] }
  },
  "active": false,
  "settings": { "executionTimeout": 600, "timezone": "UTC" },
  "meta": { "n8nDescriptionMetadataVersionId": "0" }
}
