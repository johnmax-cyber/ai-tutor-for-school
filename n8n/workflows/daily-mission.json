{
  "name": "daily-mission",
  "nodes": [
    {
      "parameters": {
        "triggerTimes": { "interval": [ { "cron": "0 8 * * *" } ] }
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000001",
      "name": "Every day at 8 AM",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1.2,
      "position": [280, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.NEXT_PUBLIC_SUPABASE_URL}}/rest/v1/user_preferences?select=user_id&daily_mission_enabled=eq.true",
        "authentication": "none",
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}" },
            { "name": "Authorization", "value": "=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}" }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000002",
      "name": "Supabase: daily-mission-enabled users",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [520, 300]
    },
    {
      "parameters": { "batchSize": 10 },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Split in batches (users)",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 1,
      "position": [760, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.APP_URL}}/api/webhooks/n8n/generate-daily-mission",
        "authentication": "none",
        "headerParameters": {
          "parameters": [
            { "name": "x-n8n-webhook-secret", "value": "={{$env.N8N_WEBHOOK_SECRET}}" }
          ]
        },
        "body": {
          "userId": "={{$json.user_id}}"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000004",
      "name": "Call generate-daily-mission webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1000, 300]
    }
  ],
  "connections": {
    "Every day at 8 AM": { "main": [ [ { "node": "Supabase: daily-mission-enabled users", "type": "main", "index": 0 } ] ] },
    "Supabase: daily-mission-enabled users": { "main": [ [ { "node": "Split in batches (users)", "type": "main", "index": 0 } ] ] },
    "Split in batches (users)": { "main": [ [ { "node": "Call generate-daily-mission webhook", "type": "main", "index": 0 } ] ] }
  },
  "active": false,
  "settings": { "executionTimeout": 600, "timezone": "UTC" },
  "meta": { "n8nDescriptionMetadataVersionId": "0" }
}
